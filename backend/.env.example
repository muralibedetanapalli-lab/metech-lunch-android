# Copy this file to backend/.env and fill in your values. backend/.env is git-ignored.
# Real environment variables override anything in this file.

# --- Azure Database for PostgreSQL ---
# Host from the Azure portal: Overview > "Server name" (e.g. my-server.postgres.database.azure.com).
# TLS (sslmode=require) is added automatically for non-local hosts.
DATABASE_URL=jdbc:postgresql://YOUR-SERVER.postgres.database.azure.com:5432/metech_lunch
# Flexible Server: the admin login as-is (e.g. metechadmin).
# Single Server (retired): login@servername (e.g. metechadmin@my-server).
DATABASE_USER=YOUR-LOGIN
DATABASE_PASSWORD=

# Signs login tokens. Use a long random value; changing it signs everyone out.
JWT_SECRET=

# Sign-in code for every account while there is no SMS provider (dev and pilot only).
# On a public address use a private 6-digit code, never 123456. deploy/azure.sh requires it.
# DEV_FIXED_OTP=

# Pilot without SMS: a fresh random code per sign-in, shown on the sign-in screen
# (ignored when APP_ENV=production). Anyone who knows a phone number can sign in as it.
# SHOW_OTP_ON_SCREEN=true

# Optional
# OTP_MAX_PER_HOUR=10    # sign-in code requests per phone number and role per hour
# PORT=8080
# PUBLIC_BASE_URL=http://localhost:8080
# SEED_DEMO_DATA=true     # adds the demo kitchen, offices, menu and test accounts
# APP_ENV=production      # turns off the dev OTP, mock payments and demo data
